<?xml version="1.0"?>
<configuration>
  <!-- The following appSettings are the bare minimum needed for all Atalasoft ASP.NET web apps -->
  <appSettings>
    <add key="AtalasoftWebControls_Cache" value="AtalaCache/"/>
    <add key="AtalasoftWebControls_CacheLifeTime" value="20"/>
    <add key="AtalasoftWebControls_ErrorLogging" value="true"/>
    <add key="AtalasoftWebControls_ShowClientErrors" value="true"/>
    <!-- ///////////
    // In order to enable this value you must make a directory
    // in this example "/WebResources" that is in the web root/web viewable
    // and then you must copy the contents of
    // C:\Program Files (x86)\Atalasoft\DotImage 2026.2\bin\WebResources\
    // NOTE: SKIP WebDocViewer and WebCapture subdirectories
    // those are only for the modern controls (which you should totally switch to)
    // https://www.atalasoft.com/KB2/KB/50370/INFO-WebDocumentViewer-Whitepaper-Getting-Started-With-Web-Viewing
    <add key="AtalasoftWebControls_ResourcePath" value="/WebResources/" />
-->
  </appSettings>
  <connectionStrings/>
  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <compilation debug="true" targetFramework="4.6.2"/>
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <authentication mode="Windows"/>
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.

        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
            <error statusCode="403" redirect="NoAccess.htm" />
            <error statusCode="404" redirect="FileNotFound.htm" />
        </customErrors>
        -->
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID"/>
  </system.web>
</configuration>